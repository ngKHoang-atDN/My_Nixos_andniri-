{
  /////===== LOGO =====/////
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo/logo.txt",
    // If you want to use Ascii only just remove the png path, and vice versa
  },
  "display": {
    "separator": " "
  },
  /////===== MODULES =====/////
  "modules": [
    {
      "type": "custom",
      "key": "╭────────────╮",
      "keyColor": "blue"
    },
    {
      "key": "│  user    {#34} │",
      "type": "title",
      "format": "Nguyen Hoang",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "key": "├────────────┤",
      "keyColor": "blue"
    },
    {
      "type": "os",
      "key": "│ {icon} OS      {#keys}{#34} │",
      "format": "{#38}{name} {version}{#keys} {#34}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│  Kernel  {#keys}{#34} │",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "│  DE      {#keys}{#34} │",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│  WM      {#keys}{#34} │",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ 󰏗 Packages{#keys}{#34} │",
      "keyColor": "blue",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "custom",
      "key": "╰────────────╯",
      "keyColor": "blue"
    },
    // Previously... there was a break here, but I removed it
    // so that the system info modules 
    // can be grouped together in a box.
    {
      "type": "custom",
      "key": "╭────────────╮"
    },
    {
      "type": "memory",
      "key": "│  Memory  {#keys} │",
      "format": "{#38}{used} / {total} ( {percentage}% ) {#keys} "
    },
    {
      "type": "disk",
      "key": "│  Disk    {#keys} │",
      "format": "{#38}{size-used} / {size-total} ( {size-percentage}% ){#keys} "
    },
    {
      "type": "swap",
      "key": "│  Swap    {#keys} │",
      "format": "{#38}{used} / {total} ( {percentage}% ){#keys}"
    },
    {
      "type": "cpu",
      "key": "│  CPU     {#keys} │",
      "format": "{#38}{name} ({cores-logical}){#keys}"
    },
    {
      "type": "gpu",
      "key": "│  GPU     {#keys} │",
      "format": "{#38}{vendor} {name} ({type}){#keys}"
    },
    {
    "type": "command",
    "key":  "│  OS age  {#keys} │",
    "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "battery",
      "key": "│  Battery {#keys} │"
    },
    {
      "type": "custom",
      "key": "╰────────────╯",
    },
    // commented colors, uncomment if you want to use it.
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "circle",
      "paddingLeft": 20,
      "block": {
        "width": 3,
        "range": [
          0,
          15
        ]
      }
    }
  ]
}
